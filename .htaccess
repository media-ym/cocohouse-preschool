DirectoryIndex index.php index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Hostinger turns POST /login into a redirect and drops the password.
  RewriteRule ^login$ login/index.php [L,QSA]

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} ^(www\.)?cocohouse\.in$ [NC]
  RewriteRule ^ https://cocohouse.in%{REQUEST_URI} [L,R=301]

  RewriteRule ^storage/ - [F,L]
  RewriteRule ^includes/ - [F,L]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^robots\.txt$ robots.php [L]
  RewriteRule ^privacy/?$ /privacy-policy [R=301,L]
  RewriteRule ^terms/?$ /terms-and-conditions [R=301,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^blog-post/([^/]+)/?$ blog-post/index.php?slug=$1 [L,QSA]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^author/([^/]+)/?$ author/index.php?slug=$1 [L,QSA]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([a-z0-9-]+)/?$ slug.php?path=$1 [L,QSA]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([^.]+)$ $1.html [L]
</IfModule>
